{
  "name": "rowkit",
  "version": "0.1.1",
  "description": "A professional Vue 3 toolkit — the components a product interface is built from.",
  "license": "MIT",
  "author": "Nikolai Kushner",
  "homepage": "https://rowkit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikolaiKushner/rowkit.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/NikolaiKushner/rowkit/issues",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "data-table",
    "design-system",
    "rowkit"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vue-tsc -b tsconfig.lib.json --force && vite build && node scripts/fix-dts-specifiers.mjs && node scripts/emit-styles.mjs",
    "typecheck": "vue-tsc -b --force"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@rowkit/tokens": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40"
  }
}
