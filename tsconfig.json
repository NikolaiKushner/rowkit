{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/root.tsbuildinfo",
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  // docs/.vitepress is deliberately absent: VitePress bundles its own Vite 5,
  // whose types clash with this repo's Vite 8 the moment both land in one
  // project. It has its own tsconfig, which the lint project service finds.
  "include": ["vitest.config.ts", "eslint.config.js", ".storybook/**/*.ts"]
}
