{
  "name": "rowkit-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b --force && pnpm -r --filter \"./packages/*\" typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf packages/*/dist node_modules/.tmp",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "vitest run --project storybook",
    "size": "size-limit",
    "changeset": "changeset",
    "dev": "pnpm --filter playground dev",
    "docs:props": "node packages/ui/scripts/generate-props.mjs",
    "docs:agents": "node packages/ui/scripts/generate-agents.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{js,json,yaml,yml,css,md}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@rowkit/tokens": "workspace:*",
    "@size-limit/preset-small-lib": "^13.0.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/vue3-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "rowkit": "workspace:*",
    "size-limit": "^13.0.1",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
